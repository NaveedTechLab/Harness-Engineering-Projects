{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewVerdict",
  "type": "object",
  "required": ["verdict", "tests_run", "tests_passed", "issues", "confidence"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL"]
    },
    "tests_run": {
      "type": "boolean",
      "description": "Did the reviewer actually execute the test suite itself?"
    },
    "tests_passed": {
      "type": "boolean",
      "description": "Did the test suite actually pass, per the reviewer's own run?"
    },
    "issues": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Specific problems found. Must be non-empty if verdict is FAIL."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
